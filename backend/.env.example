# Public production API host (apps use this; never commit secrets):
#   https://hopesvoice.davidgeorgehope.com
# The host may take a few minutes to go live after DNS or infra changes.
#
# xAI API key for PECS picture + spoken-audio generation.
# Grok models only. The iOS and Android apps never hold this key.
# Self-hosters bring their own key. Never commit the real value.
#
#   export XAI_API_KEY=...
#   # or copy this file to backend/.env and fill it in (backend/.env is gitignored)
#
XAI_API_KEY=
